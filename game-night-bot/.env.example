DISCORD_TOKEN=
DISCORD_GUILD_IDS=           # Comma-separated server IDs, e.g. 123456789,987654321

RAWG_API_KEY=
ANTHROPIC_API_KEY=

GAME_NIGHT_CHANNEL_IDS=      # Comma-separated channel IDs, one per server (same order as DISCORD_GUILD_IDS)

MIN_SESSIONS=3               # Minimum sessions before a game can be voted out
EARLY_EXIT_VOTES=4           # Votes required to advance early
COOLDOWN_WEEKS=4             # Weeks before a game can re-enter after leaving
REMINDER_TIME=08:00          # Time (ET) for Thursday morning reminder
VOTE_WINDOW_HOURS=12         # Hours a propose-swap vote stays open (reminder → game night = 12h)

DB_PATH=/app/data/rotation.db
