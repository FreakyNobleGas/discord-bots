# Postgres shared with the game night bot. Leave unset to run on mock data.
# Neon: use the POOLED connection string here (the bot uses the direct one).
DATABASE_URL=

# Discord guild to show (defaults to the mock guild).
DISCORD_GUILD_ID=

# Bearer token Grok Bot sends to /api/v1.
API_TOKEN=dev-grok-token

# /admin login. Generate both with: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

GAME_NIGHT_TZ=America/New_York

# Mock mode only: where Grok's posts are kept when DATABASE_URL is unset.
FEED_PATH=data/feed.json
